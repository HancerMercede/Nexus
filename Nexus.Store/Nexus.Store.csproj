<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.3.2</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild> 
        <PackageId>Nexus.Store</PackageId>
        <Authors>Hancer Mercedes</Authors>
        <Description>High-performance cache engine for .NET 10 using Garnet and MessagePack.</Description>
        <PackageTags>Cache;Redis;Garnet;Performance;MessagePack</PackageTags>
        <RepositoryUrl>https://github.com/HancerMercede/Nexus</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MessagePack" Version="3.1.4" />
      <PackageReference Include="Microsoft.Garnet" Version="2.0.0-beta.2" />
      <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    </ItemGroup>

</Project>
